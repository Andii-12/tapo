NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/tarot

ADMIN_EMAIL=admin@tarot.mn
ADMIN_PASSWORD=
# Bcrypt hashes must escape $ as \$ because Next.js expands $VAR in .env files
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-this-to-a-long-random-secret

AI_API_KEY=
AI_MODEL=gpt-4.1
AI_API_URL=https://api.openai.com/v1/chat/completions

PAYMENT_PROVIDER=mock
PAYMENT_API_URL=
PAYMENT_USERNAME=
PAYMENT_PASSWORD=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
THREE_CARD_PRICE=19900
FIVE_CARD_PRICE=29900
NATAL_PRICE=14900
PAYMENT_CURRENCY=MNT

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ТАРО <noreply@tarot.mn>"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
