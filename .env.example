# ── Local dev ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/tarot

# ── Production (Vercel + MongoDB Atlas) ────────────────────
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tarot?retryWrites=true&w=majority
#
# Atlas setup:
# 1. Create free M0 cluster → Database → Connect → Drivers → copy URI
# 2. Network Access → Add IP → Allow access from anywhere (0.0.0.0/0) for Vercel
# 3. Seed Atlas from your PC (once):
#      set MONGODB_URI=mongodb+srv://...   (Windows)
#      npm run seed
# Atlas migration (copy local DB → Atlas):
#   set ATLAS_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tarot?retryWrites=true&w=majority
#   npm run migrate:atlas
# ATLAS_MONGODB_URI=
#
# Vercel: Project → Settings → Environment Variables → add all vars below for Production

ADMIN_EMAIL=admin@tarot.mn
ADMIN_PASSWORD=
# Bcrypt: escape $ as \$ in local .env files only — paste raw hash in Vercel dashboard
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-this-to-a-long-random-secret

AI_API_KEY=
AI_MODEL=gpt-4.1
AI_API_URL=https://api.openai.com/v1/chat/completions

# Production: byl.mn (recommended) | mock (dev) | qpay (direct)
PAYMENT_PROVIDER=byl
BYL_TOKEN=
BYL_PROJECT_ID=
BYL_WEBHOOK_SECRET=
# Optional: BYL_API_URL=https://byl.mn/api/v1
# Webhook URL for Byl dashboard: {NEXT_PUBLIC_APP_URL}/api/payments/byl/callback

# QPay direct (only if PAYMENT_PROVIDER=qpay)
# PAYMENT_API_URL=https://merchant-sandbox.qpay.mn
# PAYMENT_USERNAME=
# PAYMENT_PASSWORD=
# QPAY_INVOICE_CODE=
# QPAY_CALLBACK_URL=https://your-app.vercel.app/api/payments/qpay/callback
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret-in-production
THREE_CARD_PRICE=19900
FIVE_CARD_PRICE=29900
NATAL_PRICE=14900
PAYMENT_CURRENCY=MNT

# Email — Resend (recommended, 3000/month free): https://resend.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Testing: onboarding@resend.dev | Production: verify your domain in Resend first
EMAIL_FROM="ТАРО <onboarding@resend.dev>"

# Email — SMTP (alternative if not using Resend)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="ТАРО <noreply@tarot.mn>"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
